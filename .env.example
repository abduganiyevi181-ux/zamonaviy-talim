# ========================================================
# ENVIRONMENT CONFIGURATION - ZAMONAVIY TA'LIM DIZAYNI
# ========================================================

# General Application Settings
NODE_ENV=production
PORT=4000
FRONTEND_PORT=3000
FRONTEND_URL="http://localhost:3000"

# PostgreSQL Configuration (Prisma)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=talim_db
DATABASE_URL="postgresql://postgres:your_secure_db_password@localhost:5432/talim_db?schema=public"

# Redis Configuration (Cache & Session)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-min-32-chars"

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN="your_bot_father_token_here"
TELEGRAM_BOT_USERNAME="talim_platform_bot"
TELEGRAM_WEBHOOK_SECRET="optional_random_webhook_secret_key"

# Email Provider Configuration (Resend or SMTP)
EMAIL_PROVIDER="mock" # or "resend" / "smtp"
RESEND_API_KEY=""
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@talim.uz"

# SMS OTP Provider (Eskiz / PlayMobile for Uzbekistan)
SMS_PROVIDER="mock" # or "eskiz"
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""

# File Uploads Directory
UPLOAD_DIR="uploads"

# Next.js Frontend Public Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
